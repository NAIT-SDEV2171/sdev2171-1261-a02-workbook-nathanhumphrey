{
  "expo": {
    "name": "Camera Capture Reference",
    "slug": "camera-capture-reference",
    "scheme": "cameracapturereference",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Camera Demo to open your camera for lesson 24 photo capture.",
          "microphonePermission": false
        }
      ]
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f5efe7"
    },
    "android": {
      "package": "ca.nait.sdev2171.cameracapturereference"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    }
  }
}
